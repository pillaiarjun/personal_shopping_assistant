{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "paths": { "@daily-co/daily-js": ["./node_modules/@daily-co/daily-js"] }
  },
  "include": ["vite.config.ts", "../*.ts", "../*.mjs", "../test"]
}
