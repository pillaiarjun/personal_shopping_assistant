# Copy to avatar/.env (gitignored). Never commit real values.
# From Mike (shared Tavus account):
TAVUS_API_KEY=
TAVUS_PAL_ID=
# Optional: overrides the PAL's default face. Only needed if the PAL has no default face.
TAVUS_FACE_ID=
# Dev harness only: where the router POSTs style_outfit. Leave empty to use the dev server's mock.
STYLE_OUTFIT_URL=
